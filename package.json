{
  "name": "smart-photo",
  "private": true,
  "description": "AI-powered smart photo album classification - local-first, cross-platform",
  "scripts": {
    "build": "pnpm --filter @smart-photo/core --filter @smart-photo/ai-engine run build",
    "test": "pnpm --filter @smart-photo/core --filter @smart-photo/ai-engine run test",
    "typecheck": "pnpm --filter @smart-photo/* run typecheck",
    "app:start": "pnpm --filter @smart-photo/app run start",
    "app:android": "pnpm --filter @smart-photo/app run android",
    "app:ios": "pnpm --filter @smart-photo/app run ios",
    "desktop:dev": "pnpm --filter @smart-photo/desktop run tauri:dev",
    "desktop:build": "pnpm --filter @smart-photo/desktop run tauri:build",
    "download-model": "pnpm --filter @smart-photo/ai-engine run download-model"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.1.0",
    "@types/node": "^22.0.0"
  },
  "packageManager": "pnpm@10.11.0"
}
