{
  "name": "smart-photo",
  "private": true,
  "description": "AI-powered smart photo album classification - local-first, cross-platform",
  "scripts": {
    "build": "pnpm --filter './packages/core' --filter './packages/ai-engine' run build",
    "test": "pnpm --filter './packages/*' run test",
    "typecheck": "pnpm --filter './packages/*' run typecheck",
    "app:start": "pnpm --filter @smart-photo/app run start",
    "app:android": "pnpm --filter @smart-photo/app run android",
    "app:ios": "pnpm --filter @smart-photo/app run ios"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.1.0",
    "@types/node": "^22.0.0"
  },
  "packageManager": "pnpm@10.11.0"
}
