{
  "name": "@smart-photo/ai-engine",
  "version": "0.1.0",
  "description": "AI engine with platform adapters for CLIP embedding extraction",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./adapters/*": {
      "types": "./dist/adapters/*.d.ts",
      "import": "./dist/adapters/*.js"
    }
  },
  "bin": {
    "download-model": "./dist/model/download-cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "download-model": "node dist/model/download-cli.js"
  },
  "files": ["dist"],
  "license": "MIT",
  "dependencies": {
    "@smart-photo/core": "workspace:*"
  },
  "peerDependencies": {
    "onnxruntime-react-native": "^1.20.0",
    "onnxruntime-node": "^1.20.0",
    "sharp": "^0.33.0"
  },
  "peerDependenciesMeta": {
    "onnxruntime-react-native": {
      "optional": true
    },
    "onnxruntime-node": {
      "optional": true
    },
    "sharp": {
      "optional": true
    }
  }
}
